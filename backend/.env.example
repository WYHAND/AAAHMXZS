# 环境变量样例（《开发手册》3.5 环境变量清单）
#
# 用法：复制为 backend/.env 后按本机情况修改。
#   Windows PowerShell: Copy-Item .env.example .env
#   bash:               cp .env.example .env
#
# 注意：.env 不要提交到仓库（含密钥）。

# ---------- 数据库（3.5；默认 SQLite，生产建议 PostgreSQL） ----------
# 默认：SQLite 文件。相对路径按 **backend/** 解析，首次使用前先建表：
#   cd backend && python -m app.db.init_db      （见 README §2.1）
# 本机既没有 PostgreSQL 也没有 Docker，所以默认值改成 SQLite —— 开箱即跑。
DATABASE_URL=sqlite:///./data/app.db

# 生产 / 想切回 PostgreSQL：改用下面这行即可，**不需要改任何代码**
# （但要先 `pip install psycopg2-binary`，它在 requirements.txt 里是可选注释项）
# DATABASE_URL=postgresql://ai_user:your_password@localhost:5432/ai_career

# docker-compose 内部访问 PG 时主机名要换成服务名 db，并且加 --profile postgres 启动：
# DATABASE_URL=postgresql://ai_user:your_password@db:5432/ai_career

# SQLite 专用：FastAPI 线程池 + SSE 生成器会跨线程复用同一连接，
# 必须关掉 sqlite3 的同线程检查（默认 true，通常不用改）
SQLITE_CHECK_SAME_THREAD_FALSE=true

# ---------- JWT（3.5 / 6.8 / 14.2） ----------
# 生产务必替换成随机长字符串：python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=your-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# ALGORITHM 不在 3.5 清单中，代码默认 HS256，可按需覆盖
ALGORITHM=HS256

# ---------- DeepSeek（3.5 / 7.1） ----------
# 评委/用户也可以在前端右上角「API 设置」里临时填写，覆盖这里的值；
# 前端填的 Key 只随请求发给本机后端，不落库、不写日志。
DEEPSEEK_API_KEY=sk-xxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名以官方文档为准（勘误 9.32 / 9.36），别按版本号猜：
#   deepseek-flash  = DeepSeek-V4.1-Flash-1017（便宜、快）
#   deepseek-v4-pro = DeepSeek-V4-Pro-0813（贵、强）
# ⚠️ 没有 deepseek-v4.1-flash 这种名字，传了会 400。
# 全项目统一一个模型（用户拍板"不要分配模型"）；是否需要思考由调用方声明：
#   对话正文 -> 开思考；结构化输出 / 短任务 -> 关思考（同一模型）
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=60
# 开着思考的调用更慢（实测 5-10s 常见），120s 已足够
DEEPSEEK_THINKING_TIMEOUT=120
# 对话正文 max_tokens：思考也算在这份额度里（实测总用量 447-602，2000 留约 3 倍余量）。
# 官方不填时默认 8K/64K，太大，会跑飞。
DEEPSEEK_CHAT_MAX_TOKENS=2000
DEEPSEEK_MAX_RETRIES=1

# ---------- 云端语音（面试语音对话，2026-10-22 切到阿里云百炼） ----------
# 面试语音只做「录音 -> 文字」和「文字 -> 朗读」，不保存录音、不写库；
# 转写文字仍走原来的 POST /interview/{id}/answer，复盘/评分逻辑不变。
#
# 阿里云百炼（https://bailian.console.aliyun.com/ 控制台创建 API Key）：
#   ASR：paraformer-realtime-v2（实时语音识别，WebSocket）
#   TTS：cosyvoice-v3-flash（语音合成，MP3 24kHz）
# ⚠️ DASHSCOPE_API_KEY 留空时，前端会自动隐藏语音入口、退回文字作答，不会报错。
VOICE_PROVIDER=aliyun
# 同样可在前端「API 设置」里临时填写；为空且前端也没填时，语音入口自动隐藏。
DASHSCOPE_API_KEY=
# 地域：默认 cn-beijing；只有工作空间 Key 才需要配 VOICE_REGION / VOICE_WORKSPACE_ID
VOICE_REGION=cn-beijing
# 可选：仅 "sk-ws-" 开头的工作空间 Key 需要。
# 留空时只用默认地址 wss://dashscope.aliyuncs.com/api-ws/v1/inference；
# 默认地址失败且填了 workspace id 时，会再试
#   wss://{VOICE_WORKSPACE_ID}.{VOICE_REGION}.maas.aliyuncs.com/api-ws/v1/inference
VOICE_WORKSPACE_ID=
VOICE_ASR_MODEL=paraformer-realtime-v2
VOICE_TTS_MODEL=cosyvoice-v3-flash
# 磁性理智男 longtian_v3（30–35 岁）：比有声书音色更像 HR，面试官默认
VOICE_TTS_VOICE=longtian_v3
VOICE_TIMEOUT=30
# 单次回答最长 3 分钟（16k/16bit 单声道约 5.8MB），10MB 是上传上限
VOICE_MAX_AUDIO_BYTES=10485760

# 兼容旧配置：没填 DASHSCOPE_API_KEY 时才会读 VOICE_API_KEY；
# VOICE_BASE_URL / VOICE_TTS_SPEED 已不再使用，仅保留字段避免旧 .env 报错。
# VOICE_API_KEY=
# VOICE_BASE_URL=
# VOICE_TTS_SPEED=1.0

# —— 旧硅基流动配置（已下线，留作迁移对照）——
# VOICE_PROVIDER=siliconflow
# VOICE_API_KEY=
# VOICE_BASE_URL=https://api.siliconflow.cn/v1
# VOICE_ASR_MODEL=FunAudioLLM/SenseVoiceSmall
# VOICE_TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
# VOICE_TTS_VOICE=FunAudioLLM/CosyVoice2-0.5B:alex

# ---------- 文件存储（3.5 / 13.1 / 13.2） ----------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# ---------- 应用（3.5） ----------
APP_ENV=development
DEBUG=true

# 生产是否也开放 /docs /redoc /openapi.json（默认只 DEBUG 开放）
# ENABLE_API_DOCS=false
# 请求体硬上限（字节）。语音 10MB，12MB 给 JSON 留余量；超限返回 413
# MAX_REQUEST_BODY_BYTES=12582912
# 进程内限流（登录爆破 / AI 与语音成本接口；单 worker 下有效）
# RATE_LIMIT_ENABLED=true
# 只有部署在**可信反向代理**后面才设 true，否则客户端可伪造 X-Forwarded-For 绕过按 IP 限流
# RATE_LIMIT_TRUST_PROXY_HEADERS=true

# 用户时区相对 UTC 的固定偏移小时数（不在 3.5 清单中，代码默认 +8）。
# 只影响"哪个日历日算今天"这类判断（每日一问的今日判定、连续打卡天数）；
# 库里的时间戳始终是 UTC。服务器本身跑在 UTC 时才需要改（例如填 0）。
# APP_TZ_OFFSET_HOURS=8

# ---------- CORS（3.5 未列出，但 3.10 要求允许前端 5173，见 README「待确认」） ----------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
