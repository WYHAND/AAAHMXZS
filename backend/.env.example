# 环境变量样例（《开发手册》3.5 环境变量清单）
#
# 用法：复制为 backend/.env 后按本机情况修改。
#   Windows PowerShell: Copy-Item .env.example .env
#   bash:               cp .env.example .env
#
# 注意：.env 不要提交到仓库（含密钥）。

# ---------- 数据库（3.5；默认 SQLite，生产建议 PostgreSQL） ----------
# 默认：SQLite 文件。相对路径按 **backend/** 解析，首次使用前先建表：
#   cd backend && python -m app.db.init_db      （见 README §2.1）
# 本机既没有 PostgreSQL 也没有 Docker，所以默认值改成 SQLite —— 开箱即跑。
DATABASE_URL=sqlite:///./data/app.db

# 生产 / 想切回 PostgreSQL：改用下面这行即可，**不需要改任何代码**
# （但要先 `pip install psycopg2-binary`，它在 requirements.txt 里是可选注释项）
# DATABASE_URL=postgresql://ai_user:your_password@localhost:5432/ai_career

# docker-compose 内部访问 PG 时主机名要换成服务名 db，并且加 --profile postgres 启动：
# DATABASE_URL=postgresql://ai_user:your_password@db:5432/ai_career

# SQLite 专用：FastAPI 线程池 + SSE 生成器会跨线程复用同一连接，
# 必须关掉 sqlite3 的同线程检查（默认 true，通常不用改）
SQLITE_CHECK_SAME_THREAD_FALSE=true

# ---------- JWT（3.5 / 6.8 / 14.2） ----------
# 生产务必替换成随机长字符串：python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=your-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# ALGORITHM 不在 3.5 清单中，代码默认 HS256，可按需覆盖
ALGORITHM=HS256

# ---------- DeepSeek（3.5 / 7.1） ----------
DEEPSEEK_API_KEY=sk-xxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 以下三项不在 3.5 清单中，代码有默认值，按需覆盖（见 README「待确认」）
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=60
DEEPSEEK_MAX_RETRIES=1

# ---------- 文件存储（3.5 / 13.1 / 13.2） ----------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# ---------- 应用（3.5） ----------
APP_ENV=development
DEBUG=true

# 用户时区相对 UTC 的固定偏移小时数（不在 3.5 清单中，代码默认 +8）。
# 只影响"哪个日历日算今天"这类判断（每日一问的今日判定、连续打卡天数）；
# 库里的时间戳始终是 UTC。服务器本身跑在 UTC 时才需要改（例如填 0）。
# APP_TZ_OFFSET_HOURS=8

# ---------- CORS（3.5 未列出，但 3.10 要求允许前端 5173，见 README「待确认」） ----------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
